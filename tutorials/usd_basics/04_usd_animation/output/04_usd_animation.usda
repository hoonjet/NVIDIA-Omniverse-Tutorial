#usda 1.0
(
    defaultPrim = "World"
    endTimeCode = 120
    metersPerUnit = 0.01
    startTimeCode = 1
    timeCodesPerSecond = 24
    upAxis = "Y"
)

def Xform "World"
{
    def Sphere "AnimatedSphere"
    {
        color3f[] primvars:displayColor = [(1, 0.5, 0)]
        double radius = 0.5
        double3 xformOp:translate.timeSamples = {
            0: (5, 0, 0),
            15: (3.5355339059327378, 0, 3.5355339059327378),
            30: (3.061616997868383e-16, 0, 5),
            45: (-3.5355339059327373, 0, 3.5355339059327378),
            60: (-5, 0, 6.123233995736766e-16),
            75: (-3.5355339059327386, 0, -3.5355339059327373),
            90: (-9.184850993605148e-16, 0, -5),
            105: (3.535533905932737, 0, -3.5355339059327386),
            120: (5, 0, -1.2246467991473533e-15),
        }
        uniform token[] xformOpOrder = ["xformOp:translate"]
    }

    def Cube "SpinningCube"
    {
        color3f[] primvars:displayColor = [(0, 1, 1)]
        double size = 2
        float xformOp:rotateY.timeSamples = {
            1: 0,
            30: 90,
            60: 180,
            90: 270,
            120: 360,
        }
        double3 xformOp:translate = (0, 3, 0)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:rotateY"]
    }

    def Sphere "PulsingSphere"
    {
        color3f[] primvars:displayColor = [(0.8, 0, 0.8)]
        double radius = 1
        float3 xformOp:scale.timeSamples = {
            1: (0.5, 0.5, 0.5),
            15: (2, 2, 2),
            30: (0.5, 0.5, 0.5),
            45: (2, 2, 2),
            60: (0.5, 0.5, 0.5),
            75: (2, 2, 2),
            90: (0.5, 0.5, 0.5),
            105: (2, 2, 2),
            120: (0.5, 0.5, 0.5),
        }
        double3 xformOp:translate = (-5, 0, 0)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
    }

    def Cube "ColorChangingCube"
    {
        color3f[] primvars:displayColor.timeSamples = {
            1: [(1, 0, 0)],
            30: [(0, 1, 0)],
            60: [(0, 0, 1)],
            90: [(1, 1, 0)],
            120: [(1, 0, 0)],
        }
        double size = 1.5
        double3 xformOp:translate = (5, 0, 0)
        uniform token[] xformOpOrder = ["xformOp:translate"]
    }
}

