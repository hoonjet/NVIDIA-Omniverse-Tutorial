#usda 1.0
(
    defaultPrim = "World"
    metersPerUnit = 0.01
    upAxis = "Y"
)

def Xform "World"
{
    def Cube "Cube1"
    {
        color3f[] primvars:displayColor = [(1, 0, 0)]
        double size = 5
    }

    def Sphere "Sphere1"
    {
        color3f[] primvars:displayColor = [(0, 1, 0)]
        double radius = 1.5
    }

    def Cylinder "Cylinder1"
    {
        double height = 3
        color3f[] primvars:displayColor = [(0, 0, 1)]
        double radius = 0.5
    }

    def Camera "Camera1"
    {
        float focalLength = 50
    }
}

