#usda 1.0
(
    defaultPrim = "World"
    metersPerUnit = 0.01
    upAxis = "Y"
)

def Xform "World"
{
    def Xform "SimulationObject"
    {
        custom int simulation:maxIterations = 1000
        custom float simulation:timeStep = 0.016
        custom string simulation:type = "fluid_dynamics"
        custom float3 simulation:velocity = (1, 0.5, 0)
    }
}

def "ExtensionConfig"
{
    def Xform "MyExtension"
    {
        custom bool autoUpdate = 0
        custom bool enabled = 1
        custom string logLevel = "INFO"
        custom string[] targetPrims = ["/World/SimulationObject", "/World/AnotherObject"]
        custom float updateInterval = 1
    }
}

