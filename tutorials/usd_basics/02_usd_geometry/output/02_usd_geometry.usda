#usda 1.0
(
    defaultPrim = "World"
    metersPerUnit = 0.01
    upAxis = "Y"
)

def Xform "World"
{
    def Xform "Shapes"
    {
        def Cube "Cube"
        {
            color3f[] primvars:displayColor = [(1, 0.2, 0.2)]
            double size = 2
            double3 xformOp:translate = (5, 0, 0)
            uniform token[] xformOpOrder = ["xformOp:translate"]
        }

        def Sphere "Sphere"
        {
            color3f[] primvars:displayColor = [(0.2, 1, 0.2)]
            double radius = 1
            float xformOp:rotateZ = 45
            double3 xformOp:translate = (-5, 0, 0)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:rotateZ"]
        }

        def Cylinder "Cylinder"
        {
            double height = 3
            color3f[] primvars:displayColor = [(0.2, 0.2, 1)]
            double radius = 0.5
            float3 xformOp:scale = (2, 2, 0.5)
            double3 xformOp:translate = (0, 5, 0)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
        }

        def Cone "Cone"
        {
            double height = 2
            color3f[] primvars:displayColor = [(1, 0.6, 0)]
            double radius = 1
            float3 xformOp:rotateXYZ = (90, 0, 0)
            float3 xformOp:scale = (1.5, 1.5, 1.5)
            double3 xformOp:translate = (0, -5, 0)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:rotateXYZ", "xformOp:scale"]
        }

        def Plane "Plane"
        {
            double length = 10
            color3f[] primvars:displayColor = [(0.5, 0.5, 0.5)]
            double width = 10
        }

        def Capsule "Capsule"
        {
            double height = 2
            color3f[] primvars:displayColor = [(0.8, 0.2, 0.8)]
            double radius = 0.5
            float3 xformOp:rotateXYZ = (0, 0, 30)
            float3 xformOp:scale = (1, 1, 1)
            double3 xformOp:translate = (0, 0, 5)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:rotateXYZ", "xformOp:scale"]
        }
    }
}

